{
    "name": "backend",
    "version": "0.1.0",
    "private": true,
    "license": "UNLICENSED",
    "engines": {
        "node": ">=22"
    },
    "scripts": {
        "build": "nest build",
        "postbuild": "dotenv -e .env.test -- node dist/main.js --validate",
        "format": "prettier --write \"src/**/*.ts\"",
        "start": "nest start",
        "start:dev": "nest start --watch",
        "start:debug": "nest start --debug --watch",
        "start:prod": "node dist/main",
        "typecheck": "tsc --noEmit -p tsconfig.json",
        "test": "dotenv -e .env.test -- jest --config ./jest.config.ts",
        "test:watch": "dotenv -e .env.test -- jest --config ./jest.config.ts --watch",
        "test:cov": "dotenv -e .env.test -- jest --config ./jest.config.ts --coverage",
        "test:e2e": "dotenv -e .env.test -- jest --config ./jest.e2e.config.ts",
        "test:int": "dotenv -e .env.test -- jest --config ./jest.int.config.ts",
        "test:all": "npm test && npm run test:e2e && npm run test:int",
        "migrate:dev": "prisma migrate dev",
        "migrate:deploy": "prisma migrate deploy",
        "prisma:generate": "prisma generate"
    },
    "dependencies": {
        "@clerk/backend": "^3.27.0",
        "@date-fns/tz": "^1.5.0",
        "@nestjs/common": "^11.2.8",
        "@nestjs/config": "^4.0.4",
        "@nestjs/core": "^11.2.8",
        "@nestjs/platform-express": "^11.2.8",
        "@nestjs/swagger": "^11.4.8",
        "@prisma/client": "^6.19.3",
        "class-transformer": "^0.5.1",
        "class-validator": "^0.14.4",
        "date-fns": "^4.4.0",
        "reflect-metadata": "^0.2.2",
        "rxjs": "^7.8.2"
    },
    "devDependencies": {
        "@nestjs/cli": "^11.0.24",
        "@nestjs/schematics": "^11.1.0",
        "@nestjs/testing": "^11.2.8",
        "@types/express": "^5.0.6",
        "@types/jest": "^30.0.0",
        "@types/node": "^22.20.5",
        "@types/supertest": "^6.0.3",
        "dotenv-cli": "^8.0.0",
        "embedded-postgres": "16.15.0-beta.19",
        "jest": "^30.2.0",
        "prettier": "^3.6.2",
        "prisma": "^6.19.3",
        "source-map-support": "^0.5.21",
        "supertest": "^7.1.4",
        "ts-jest": "^29.4.6",
        "ts-node": "^10.9.2",
        "tsconfig-paths": "^4.2.0",
        "typescript": "^5.9.3"
    }
}
