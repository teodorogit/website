# Copy to .env and fill in. Required unless marked optional.
# One of development | test | production. Unset means production. API docs (/api/docs) and
# debug logs are only enabled with development.
NODE_ENV=development
PORT=3001

# PostgreSQL (see docker-compose.yml)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/brigadeiro?schema=public

# Frontend origin(s) allowed by CORS, comma-separated
FRONTEND_URL=http://localhost:5173

# Clerk — Dashboard > API keys. CLERK_ISSUER is the Frontend API URL (the `iss` claim of session tokens).
CLERK_SECRET_KEY=sk_test_xxx
CLERK_ISSUER=https://your-instance.clerk.accounts.dev
# PEM public key for networkless verification (Dashboard > API keys > JWT public key).
# REQUIRED in production (the app refuses to boot without it); optional in development/test.
CLERK_JWT_KEY=
# Optional: comma-separated origins accepted in the token azp claim (defaults to FRONTEND_URL)
CLERK_AUTHORIZED_PARTIES=

# Ollama (BACKEND_SCOPE.md §5)
OLLAMA_URL=http://localhost:11434
CHAT_MODEL=llama3.2
EMBEDDING_MODEL=embeddinggemma
# Optional: timeout for one Ollama call, in ms (default 120000)
OLLAMA_TIMEOUT_MS=
# Optional: concurrent POST /api/chat requests per user (default 1) and per process (default 4);
# above either limit the API answers 429 TOO_MANY_REQUESTS.
CHAT_MAX_INFLIGHT_PER_USER=
CHAT_MAX_INFLIGHT_GLOBAL=
